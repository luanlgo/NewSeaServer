{
  "name": "sea-of-code",
  "version": "1.0.0",
  "description": "Multiplayer 3D naval battle game",
  "main": "server.js",
  "scripts": {
    "kill": "npx kill-port 3000 3001",
    "server": "nodemon server.js",
