    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "clean-css-cli": "^5.6.3",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^29.0.1",
    "lightningcss": "^1.31.1",
    "nodemon": "^3.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
